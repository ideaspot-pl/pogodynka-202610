{
    "city": "{{ city }}",
    "country": "{{ country }}",
    "measurements": [
        {% for measurement in measurements %}
        {
            "date": "{{ measurement.date | date('Y-m-d') | raw }}",
            "celsius": "{{ measurement.celsius }}"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
